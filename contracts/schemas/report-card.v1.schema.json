{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konkurcom.example/contracts/report-card.v1.schema.json",
  "title": "report-card.v1",
  "description": "No PII: additionalProperties is false everywhere, so name/phone/national_id/email/image fields are structurally rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "anonymous_id",
    "exam_year",
    "degree",
    "field",
    "quota",
    "subject_scores",
    "rank",
    "admissions",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "report-card.v1" },
    "external_id": { "type": "string", "minLength": 1 },
    "anonymous_id": { "type": "string", "minLength": 1 },
    "exam_year": { "type": "integer", "minimum": 1300, "maximum": 1500 },
    "degree": { "type": "string", "enum": ["master", "phd"] },
    "field": { "type": "string", "minLength": 1 },
    "quota": { "type": "string", "minLength": 1 },
    "subject_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_code", "percent"],
        "properties": {
          "subject_code": { "type": "string", "minLength": 1 },
          "percent": { "type": "number", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "scope"],
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "enum": ["national", "quota", "field"] }
      }
    },
    "admissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program_code", "status"],
        "properties": {
          "program_code": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["accepted", "rejected", "waitlisted"]
          }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_type", "source_artifact"],
      "properties": {
        "producer_type": { "type": "string", "enum": ["external_ai", "human"] },
        "producer_name": { "type": "string" },
        "producer_version": { "type": "string" },
        "source_artifact": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
