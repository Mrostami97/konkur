{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konkurcom.example/contracts/article.v1.schema.json",
  "title": "article.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "title",
    "slug",
    "summary",
    "content_blocks",
    "taxonomy",
    "provenance",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "article.v1" },
    "external_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "content_blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentBlock" }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major"],
      "properties": {
        "major": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "page": { "type": "integer", "minimum": 1 }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" },
      "default": []
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "review_status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "rejected"]
    }
  },
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "text"],
          "properties": {
            "type": { "const": "heading" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "quote" },
            "text": { "type": "string", "minLength": 1 },
            "cite": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "media_key"],
          "properties": {
            "type": { "const": "image" },
            "media_key": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "caption": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "table" },
            "headers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "latex"],
          "properties": {
            "type": { "const": "latex" },
            "latex": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_key", "filename", "mime_type", "checksum"],
      "properties": {
        "media_key": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_type", "source_artifact"],
      "properties": {
        "producer_type": { "type": "string", "enum": ["external_ai", "human"] },
        "producer_name": { "type": "string" },
        "producer_version": { "type": "string" },
        "source_artifact": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
