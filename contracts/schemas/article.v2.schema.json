{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kunkur01.ir/contracts/article.v2.schema.json",
  "title": "article.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "content_type",
    "title",
    "slug",
    "summary",
    "quick_answer",
    "content_blocks",
    "taxonomy",
    "seo",
    "validity",
    "sources",
    "provenance",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "article.v2" },
    "external_id": { "type": "string", "minLength": 1 },
    "content_type": {
      "type": "string",
      "enum": ["article", "guide", "news", "case_study"]
    },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "quick_answer": { "type": "string", "minLength": 1 },
    "content_blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://konkurcom.example/contracts/article.v1.schema.json#/$defs/contentBlock" }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "degrees", "fields", "subject_codes", "topic_codes"],
      "properties": {
        "major": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "degrees": {
          "type": "array",
          "items": { "type": "string", "enum": ["master", "phd"] },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "subject_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "topic_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 70 },
        "description": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_sensitive"],
      "properties": {
        "exam_year": { "type": "integer", "minimum": 1300, "maximum": 1600 },
        "time_sensitive": { "type": "boolean" },
        "source_checked_at": { "type": "string", "format": "date-time" },
        "review_due_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "time_sensitive": { "const": true } } },
          "then": {
            "properties": {
              "source_checked_at": true,
              "review_due_at": true
            },
            "required": ["source_checked_at", "review_due_at"]
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_external_id", "relation"],
        "properties": {
          "source_external_id": { "type": "string", "minLength": 1 },
          "relation": {
            "type": "string",
            "enum": [
              "DEFINES",
              "SUPPORTS",
              "DERIVED_FROM",
              "TRANSLATION_OF",
              "ANSWER_KEY_FOR",
              "CORRECTS",
              "SUPERSEDES"
            ]
          },
          "locator": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "https://konkurcom.example/contracts/article.v1.schema.json#/$defs/asset" },
      "default": []
    },
    "provenance": { "$ref": "https://konkurcom.example/contracts/article.v1.schema.json#/$defs/provenance" },
    "review_status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "rejected"]
    }
  }
}
