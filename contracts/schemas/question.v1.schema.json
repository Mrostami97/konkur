{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konkurcom.example/contracts/question.v1.schema.json",
  "title": "question.v1",
  "description": "Structural rule enforced here: exactly 4 options. The stronger rule (option numbers are exactly {1,2,3,4} each once, and correct_option references one of them) is enforced by the companion validator in src/validators.ts, not by JSON Schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "exam",
    "subject_code",
    "topic_codes",
    "stem_blocks",
    "options",
    "correct_option",
    "solution_blocks",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "question.v1" },
    "external_id": { "type": "string", "minLength": 1 },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degree", "major", "year"],
      "properties": {
        "degree": { "type": "string", "enum": ["master", "phd"] },
        "major": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1300, "maximum": 1500 }
      }
    },
    "subject_code": { "type": "string", "minLength": 1 },
    "topic_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stem_blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/questionBlock" }
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "blocks"],
        "properties": {
          "number": { "type": "integer", "enum": [1, 2, 3, 4] },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/questionBlock" }
          }
        }
      }
    },
    "correct_option": { "type": "integer", "enum": [1, 2, 3, 4] },
    "solution_blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/questionBlock" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" },
      "default": []
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "question_number": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "questionBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "latex"],
          "properties": {
            "type": { "const": "latex" },
            "latex": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "media_key"],
          "properties": {
            "type": { "const": "image" },
            "media_key": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "table" },
            "headers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "media_key"],
          "properties": {
            "type": { "const": "chart" },
            "media_key": { "type": "string", "minLength": 1 },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_key", "filename", "mime_type", "checksum"],
      "properties": {
        "media_key": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_type", "source_artifact"],
      "properties": {
        "producer_type": { "type": "string", "enum": ["external_ai", "human"] },
        "producer_name": { "type": "string" },
        "producer_version": { "type": "string" },
        "source_artifact": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
