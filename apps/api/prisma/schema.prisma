generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RBAC roles per doc §9: Student, Mentor, Author, Reviewer, Admin, Finance.
// A user can hold more than one role (e.g. Mentor + Author), hence a join table.
enum Role {
  STUDENT
  MENTOR
  AUTHOR
  REVIEWER
  ADMIN
  FINANCE
}

model User {
  id          String       @id @default(uuid())
  phone       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       UserRole[]
  sessions    Session[]
  otpCodes    OtpCode[]
  consents    Consent[]
  profile     Profile?
  enrollments Enrollment[]
  orders      Order[]
  entitlements Entitlement[] @relation("EntitlementUser")
  attempts    Attempt[]
  goal        Goal?
  studySessions StudySession[]
  masteryStates MasteryState[]
  rankEstimates RankEstimate[]
  choiceList  ChoiceList?

  @@map("users")
}

// doc §6.1 groups this under "هویت و پروفایل" (identity & profile) alongside
// users/roles/consents -- not a separate module boundary.
model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?
  targetDegree  Degree?
  targetField   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("profiles")
}

enum Degree {
  MASTER
  PHD
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("otp_codes")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model Consent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  version    String
  acceptedAt DateTime @default(now())

  @@index([userId])
  @@map("consents")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Content (doc §5.2): admin-authored articles for the Portal in Phase 1.
// Bulk JSON ingestion (Staging/Review/Publish, article_versions history) is
// Phase 2; this table is designed so that pipeline can write into it later
// without a schema change. Full version history is deliberately not built
// yet -- see AGENTS.md Phase 1 simplifications.
// ---------------------------------------------------------------------------
enum ReviewStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

model Article {
  id            String       @id @default(uuid())
  // Set only for admin-authored content (Phase 1 path); ingested articles
  // (Phase 2 path) carry provenance instead of an internal author.
  authorId      String?
  // Set only for ingested content (Phase 2 path) -- the article.v1 contract's
  // external_id, for dedup/idempotent-reimport matching.
  externalId    String?      @unique
  provenance    Json?
  version       Int          @default(1)
  slug          String       @unique
  title         String
  summary       String
  contentBlocks Json
  // Set only for ingested content -- the article.v1 contract's media_key ->
  // checksum manifest, so image/chart blocks can be resolved to /media/:checksum.
  assets        Json         @default("[]")
  taxonomyMajor String[]
  taxonomyTags  String[]     @default([])
  reviewStatus  ReviewStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([reviewStatus])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Learning (doc §5.2): course/lesson content + enrollment + progress.
// Lesson content is intentionally simple blocks (text/heading/image/video-url)
// -- no upload/streaming infra yet, no LaTeX/rich question content (Phase 3).
// ---------------------------------------------------------------------------
model Course {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String
  isPublished Boolean        @default(false)
  modules     CourseModule[]
  products    Product[]
  enrollments Enrollment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id             String           @id @default(uuid())
  courseModuleId String
  courseModule   CourseModule     @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  contentBlocks  Json
  progress       LessonProgress[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([courseModuleId])
  @@map("lessons")
}

enum EnrollmentSource {
  PURCHASE
  GIFT
  MANUAL
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source     EnrollmentSource
  enrolledAt DateTime         @default(now())
  revokedAt  DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String    @id @default(uuid())
  userId       String
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// Commerce (doc §5.2/§8.1): the only source of truth for "is access active".
// Only COURSE-kind products exist in Phase 1 (nothing else is sellable yet --
// Study Pro/Mentor/Admissions packages need modules that don't exist until
// later phases). Coupons and subscriptions are deferred -- see AGENTS.md.
// No real payment gateway is chosen yet (doc §12.1), so PaymentProvider is a
// swappable interface with a "manual-sandbox" implementation for now, same
// pattern as the OTP provider in Phase 0.
// ---------------------------------------------------------------------------
enum ProductKind {
  COURSE
}

model Product {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String
  kind        ProductKind
  courseId    String?
  course      Course?       @relation(fields: [courseId], references: [id])
  isActive    Boolean       @default(true)
  prices      Price[]
  orderItems  OrderItem[]
  entitlements Entitlement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("products")
}

model Price {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountRial    Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]

  @@index([productId])
  @@map("prices")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  totalAmountRial Int
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  priceId    String
  price      Price   @relation(fields: [priceId], references: [id])
  quantity   Int     @default(1)
  amountRial Int

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String        @unique
  status      PaymentStatus @default(PENDING)
  amountRial  Int
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([orderId])
  @@map("payments")
}

enum EntitlementGrantSource {
  ORDER
  GIFT
  MANUAL
  TRIAL
}

model Entitlement {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation("EntitlementUser", fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product                @relation(fields: [productId], references: [id])
  grantedVia      EntitlementGrantSource
  reason          String?
  grantedByUserId String?
  startAt         DateTime               @default(now())
  endAt           DateTime?
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())

  @@index([userId])
  @@index([productId])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// Content: minimal canonical tables for ingested question.v1 / report-card.v1
// data (doc §6.1). Deliberately thin -- just enough structure to prove the
// ingestion pipeline publishes real, queryable, versioned rows. Rich modeling
// (normalized Topic/Tag/Option entities, full-text search, a block renderer)
// is Phase 3's Content Engine; this table's shape does not need to survive
// that rewrite unchanged.
// ---------------------------------------------------------------------------
model Question {
  id            String   @id @default(uuid())
  externalId    String   @unique
  examDegree    Degree
  examMajor     String
  examYear      Int
  subjectCode   String
  topicCodes    String[]
  stemBlocks    Json
  options       Json
  correctOption Int
  solutionBlocks Json
  assets        Json     @default("[]")
  source        Json?
  provenance    Json
  version       Int      @default(1)
  examItems     ExamItem[]
  answers       Answer[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subjectCode])
  @@map("questions")
}

model ReportCard {
  id            String   @id @default(uuid())
  externalId    String   @unique
  anonymousId   String
  examYear      Int
  degree        Degree
  field         String
  quota         String
  subjectScores Json
  rank          Json
  admissions    Json
  provenance    Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([examYear, degree, field])
  @@map("report_cards")
}

// ---------------------------------------------------------------------------
// Ingestion (doc §5.2/§6.2): the only path from external JSON/ZIP to canonical
// data. Receive -> Schema -> Staging -> Normalize -> Assets -> Deduplicate ->
// Domain QA -> Review -> Publish. No external tool ever writes to Article/
// Question/ReportCard directly -- only IngestionService.publish() does, and
// only for items an ImportItem review approved.
// ---------------------------------------------------------------------------
enum ImportJobStatus {
  RECEIVED
  STAGED
  REVIEWED
  PUBLISHED
  FAILED
}

model ImportJob {
  id             String          @id @default(uuid())
  schemaVersion  String
  idempotencyKey String          @unique
  status         ImportJobStatus @default(RECEIVED)
  submittedBy    String?
  totalItems     Int             @default(0)
  items          ImportItem[]
  createdAt      DateTime        @default(now())

  @@map("import_jobs")
}

enum ImportItemStatus {
  PENDING
  VALID
  INVALID
  APPROVED
  REJECTED
  PUBLISHED
}

enum DedupeStatus {
  NEW
  MATCH
  CONFLICT
}

model ImportItem {
  id                String           @id @default(uuid())
  importJobId       String
  importJob         ImportJob        @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  externalId        String
  rawPayload        Json
  status            ImportItemStatus @default(PENDING)
  validationErrors  Json             @default("[]")
  dedupeStatus      DedupeStatus?
  publishedEntityId String?
  publishedVersion  Int?
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())

  @@index([importJobId])
  @@index([status])
  @@map("import_items")
}

model SourceArtifact {
  id         String   @id @default(uuid())
  checksum   String   @unique
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  @@map("source_artifacts")
}

// Generic version history so any ingested entity (article/question/report
// card) can be rolled back to a prior snapshot without a per-domain
// versions table. Rollback creates a NEW version copying an old snapshot's
// payload rather than destroying history (doc §10.2: "بازگشت نسخه بدون خرابی").
enum VersionedEntityType {
  ARTICLE
  QUESTION
  REPORT_CARD
}

model ContentVersion {
  id          String              @id @default(uuid())
  entityType  VersionedEntityType
  entityId    String
  version     Int
  payload     Json
  publishedByImportItemId String?
  createdAt   DateTime            @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("content_versions")
}

// ---------------------------------------------------------------------------
// Taxonomy (doc §6.1, phase 3 deliverable): canonical Subject/Topic catalog.
// Question.subjectCode/topicCodes and Article.taxonomyMajor/taxonomyTags stay
// as plain strings (that's the shape the article.v1/question.v1 contracts
// fix) -- this catalog is what a Topic-browsing UI reads, and what content
// authoring validates codes against; it is not wired as a foreign key onto
// the ingested tables themselves.
// ---------------------------------------------------------------------------
model Subject {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  topics    Topic[]
  createdAt DateTime @default(now())

  @@map("subjects")
}

model Topic {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([subjectId])
  @@map("topics")
}

// ---------------------------------------------------------------------------
// Assessment (doc §5.2/§6.1, phase 4): the only place scores/answers are
// authoritative. Exam is the blueprint; ExamForm is one concrete, ordered set
// of questions (STATIC exams reuse one shared form; DYNAMIC exams get a
// fresh, randomly-drawn form per attempt -- simpler to reason about than a
// shared adaptive pool, and still meaningfully "dynamic").
// ---------------------------------------------------------------------------
enum ExamMode {
  STATIC
  DYNAMIC
}

model Exam {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  description     String
  mode            ExamMode
  durationMinutes Int
  // DYNAMIC-mode selection rule: draw questionCount random published
  // questions matching subjectCode. Not used for STATIC exams.
  subjectCode     String?
  questionCount   Int?
  isPublished     Boolean    @default(false)
  createdBy       String?
  forms           ExamForm[]
  attempts        Attempt[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("exams")
}

model ExamForm {
  id        String     @id @default(uuid())
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  items     ExamItem[]
  attempts  Attempt[]
  createdAt DateTime   @default(now())

  @@index([examId])
  @@map("exam_forms")
}

model ExamItem {
  id         String   @id @default(uuid())
  examFormId String
  examForm   ExamForm @relation(fields: [examFormId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int
  points     Float    @default(1)

  @@unique([examFormId, questionId])
  @@index([examFormId])
  @@map("exam_items")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id          String        @id @default(uuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id])
  examFormId  String
  examForm    ExamForm      @relation(fields: [examFormId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  answers     Answer[]
  score       Score?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([examId])
  @@map("attempts")
}

model Answer {
  id             String   @id @default(uuid())
  attemptId      String
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  selectedOption Int?
  answeredAt     DateTime @default(now())

  @@unique([attemptId, questionId])
  @@map("answers")
}

// scoreVersion makes every score reproducible/auditable even if the scoring
// rule changes later (doc's "estimator_version"-style discipline, applied
// here to grading instead of rank estimation).
model Score {
  id              String   @id @default(uuid())
  attemptId       String   @unique
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scoreVersion    String
  correctCount    Int
  wrongCount      Int
  unansweredCount Int
  rawScore        Float
  percentCorrect  Float
  computedAt      DateTime @default(now())

  @@map("scores")
}

// Transactional Outbox (doc §5.1): domain changes and their events are written
// in the same DB transaction. No consumer exists yet in Phase 0 -- later phases
// ---------------------------------------------------------------------------
// Planning (doc §5.2/§6.1, phase 5): consumes Mastery, produces activity. One
// active Goal per user for now (a student changes their goal in place rather
// than juggling several); Plan/Task/StudySession are Planning's own; Mastery
// belongs to Analytics per doc's module table, but this is the only slice of
// Analytics phase 5 needs (Benchmark/Prediction are Phase 6's rank engine).
// ---------------------------------------------------------------------------
model Goal {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree         Degree
  field          String
  targetExamDate DateTime?
  weeklyHours    Int
  plans          Plan[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("goals")
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

model Plan {
  id        String         @id @default(uuid())
  goalId    String
  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  status    PlanStatus     @default(ACTIVE)
  version   Int            @default(1)
  tasks     Task[]
  revisions PlanRevision[]
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([userId, status])
  @@map("plans")
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model Task {
  id               String     @id @default(uuid())
  planId           String
  plan             Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectCode      String
  topicCode        String?
  title            String
  estimatedMinutes Int
  scheduledFor     DateTime
  priority         Int
  reasonCode       String
  status           TaskStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  @@index([planId])
  @@index([planId, scheduledFor])
  @@map("tasks")
}

// Every (re)plan action is recorded here -- doc §10.2 Phase 5 DoD:
// "reason_code، تاریخچه تغییر" (reason_code, change history).
model PlanRevision {
  id         String   @id @default(uuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reasonCode String
  summary    String
  createdAt  DateTime @default(now())

  @@index([planId])
  @@map("plan_revisions")
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode String
  topicCode   String?
  minutes     Int
  taskId      String?
  loggedAt    DateTime @default(now())

  @@index([userId])
  @@map("study_sessions")
}

// Deterministic, versioned, rule-based -- doc §7: "وزن‌دهی صحت، سختی، تازگی و
// تعداد شواهد با فرمول ثابت" (weight correctness, difficulty, recency, and
// evidence count with a fixed formula). Never a black-box/ML estimate.
model MasteryState {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode   String
  topicCode     String
  masteryScore  Float
  confidence    String
  evidenceCount Int
  ruleVersion   String
  computedAt    DateTime @default(now())

  @@unique([userId, topicCode])
  @@index([userId])
  @@map("mastery_states")
}

// (Planning/CRM/Notification) add a poller/dispatcher that reads unpublished rows.
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([eventType])
  @@index([publishedAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Admissions (doc §2's module list): university/program/capacity catalog +
// a student's ordered choice list. Depends on Analytics (below) to show an
// acceptance chance per program; never the other way around.
// ---------------------------------------------------------------------------
enum TuitionType {
  FREE
  PAID
}

model University {
  id        String    @id @default(uuid())
  code      String    @unique
  title     String
  city      String
  programs  Program[]
  createdAt DateTime  @default(now())

  @@map("universities")
}

model Program {
  id           String           @id @default(uuid())
  universityId String
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  code         String           @unique
  title        String
  degree       Degree
  field        String
  tuitionType  TuitionType
  hasDormitory Boolean          @default(false)
  capacities   Capacity[]
  choiceItems  ChoiceListItem[]
  createdAt    DateTime         @default(now())

  @@index([degree, field])
  @@map("programs")
}

model Capacity {
  id        String  @id @default(uuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  examYear  Int
  quota     String
  capacity  Int

  @@unique([programId, examYear, quota])
  @@map("capacities")
}

model ChoiceList {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ChoiceListItem[]
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@map("choice_lists")
}

model ChoiceListItem {
  id           String     @id @default(uuid())
  choiceListId String
  choiceList   ChoiceList @relation(fields: [choiceListId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id])
  priority     Int

  @@unique([choiceListId, programId])
  @@index([choiceListId])
  @@map("choice_list_items")
}

// ---------------------------------------------------------------------------
// Analytics -- Benchmark/Prediction slice (doc §6.1/§6.5/§7): a k-nearest-
// neighbor rank estimate against real, approved ReportCard comparables.
// Never a bare number -- always median + interval + confidence + comparables
// + methodology + per-subject sensitivity, versioned and backtestable.
// ---------------------------------------------------------------------------
model RankEstimate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimatorVersion String
  degree           Degree
  field            String
  quota            String
  subjectScores    Json
  rankMedian       Int
  rankP50Low       Int
  rankP50High      Int
  rankP80Low       Int
  rankP80High      Int
  confidence       String
  comparableCount  Int
  comparableYears  Int[]
  sensitivity      Json
  methodology      String
  generatedAt      DateTime @default(now())

  @@index([userId])
  @@map("rank_estimates")
}

// doc's Phase 6 DoD: "Backtest، گزارش خطا" -- run the same estimator against
// known historical report cards and record how well its intervals actually
// covered the real outcome (doc §11's "Prediction Calibration" metric).
model BacktestReport {
  id                  String   @id @default(uuid())
  estimatorVersion    String
  sampleSize          Int
  coverageP50         Float
  coverageP80         Float
  meanAbsPercentError Float
  computedAt          DateTime @default(now())

  @@map("backtest_reports")
}
