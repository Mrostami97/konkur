generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RBAC roles per doc §9: Student, Mentor, Author, Reviewer, Admin, Finance.
// A user can hold more than one role (e.g. Mentor + Author), hence a join table.
enum Role {
  STUDENT
  MENTOR
  AUTHOR
  REVIEWER
  ADMIN
  FINANCE
}

model User {
  id                   String                @id @default(uuid())
  phone                String                @unique
  // Nullable so OTP-only users continue to work. Password authentication is
  // enabled for users that have a password credential provisioned.
  passwordHash         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  roles                UserRole[]
  sessions             Session[]
  otpCodes             OtpCode[]
  consents             Consent[]
  profile              Profile?
  enrollments          Enrollment[]
  orders               Order[]
  entitlements         Entitlement[]         @relation("EntitlementUser")
  attempts             Attempt[]
  goal                 Goal?
  studySessions        StudySession[]
  savedResources       SavedResource[]
  masteryStates        MasteryState[]
  practiceAnswers      PracticeAnswer[]
  questionMarks        QuestionMark[]
  rankEstimates        RankEstimate[]
  choiceList           ChoiceList?
  lead                 Lead?
  contributorProfile   ContributorProfile?
  consultationBookings ConsultationBooking[] @relation("ConsultationStudent")
  spotPlayerLicenses   SpotPlayerLicense[]
  videoLicense         StudentVideoLicense?
  telegramAccount      TelegramAccount?
  videoLicenseRequests VideoLicenseRequest[]
  coachPlans           CoachPlan[]           @relation("CoachPlanStudent")
  weeklyReports        WeeklyReport[]        @relation("WeeklyReportStudent")

  @@map("users")
}

// doc §6.1 groups this under "هویت و پروفایل" (identity & profile) alongside
// users/roles/consents -- not a separate module boundary.
model Profile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?
  /// Name and education are the student's own answers, required before an
  /// exam attempt (see ProfileService.assertExamReady). Never public.
  firstName       String?
  lastName        String?
  educationStatus EducationStatus?
  universityName  String?
  fieldOfStudy    String?
  /// Solar years, e.g. 1400.
  entryYear       Int?
  graduationYear  Int?
  /// Grade average on the 0-20 scale; optional.
  gpa             Float?
  targetDegree    Degree?
  targetField     String?
  targetExamYear  Int?
  /// When the required fields were first all filled in.
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("profiles")
}

enum EducationStatus {
  BACHELOR_STUDENT
  BACHELOR_GRADUATE
  MASTER_STUDENT
  MASTER_GRADUATE
  OTHER
}

enum Degree {
  MASTER
  PHD
}

enum SelfReportedLevel {
  UNKNOWN
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("otp_codes")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model Consent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  version    String
  acceptedAt DateTime @default(now())

  @@index([userId])
  @@map("consents")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Content (doc §5.2): admin-authored articles for the Portal in Phase 1.
// Bulk JSON ingestion (Staging/Review/Publish, article_versions history) is
// Phase 2; this table is designed so that pipeline can write into it later
// without a schema change. Full version history is deliberately not built
// yet -- see AGENTS.md Phase 1 simplifications.
// ---------------------------------------------------------------------------
enum ReviewStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

enum ArticleContentType {
  ARTICLE
  GUIDE
  NEWS
  CASE_STUDY
}

enum ContributorKind {
  PERSON
  ORGANIZATION
}

enum AccessMode {
  PUBLIC
  ACCOUNT
  ENTITLEMENT
}

enum ResourceKind {
  NOTE
  VIDEO
  PDF
  EXTERNAL_LINK
  OFFICIAL_NOTICE
  EXAM_PROGRAM
  REGISTRATION_BOOKLET
  QUESTION_BOOKLET
  ANSWER_KEY
  CORRECTION
  ACADEMIC_SYLLABUS
  OPEN_TEXTBOOK
  OLYMPIAD_PROBLEM_SET
  OLYMPIAD_SOLUTION
  TELEGRAM_POST
  TRANSCRIPT
}

enum ResourceHostingMode {
  METADATA_ONLY
  EXTERNAL_LINK
  OFFICIAL_EMBED
  USER_UPLOAD
  MIRRORED_WITH_PERMISSION
}

model Article {
  id                String              @id @default(uuid())
  // Set only for admin-authored content (Phase 1 path); ingested articles
  // (Phase 2 path) carry provenance instead of an internal author.
  authorId          String?
  // Set only for ingested content (Phase 2 path) -- the article.v1 contract's
  // external_id, for dedup/idempotent-reimport matching.
  externalId        String?             @unique
  provenance        Json?
  version           Int                 @default(1)
  slug              String              @unique
  title             String
  summary           String
  contentBlocks     Json
  // Set only for ingested content -- the article.v1 contract's media_key ->
  // checksum manifest, so image/chart blocks can be resolved to /media/:checksum.
  assets            Json                @default("[]")
  taxonomyMajor     String[]
  taxonomyTags      String[]            @default([])
  contentType       ArticleContentType  @default(ARTICLE)
  quickAnswer       String?
  seoTitle          String?
  seoDescription    String?
  taxonomyDegrees   Degree[]            @default([])
  taxonomyFields    String[]            @default([])
  subjectCodes      String[]            @default([])
  topicCodes        String[]            @default([])
  validForYear      Int?
  authorProfileId   String?
  authorProfile     ContributorProfile? @relation("ArticleAuthor", fields: [authorProfileId], references: [id])
  reviewerProfileId String?
  reviewerProfile   ContributorProfile? @relation("ArticleReviewer", fields: [reviewerProfileId], references: [id])
  reviewedAt        DateTime?
  sourceValidatedAt DateTime?
  reviewDueAt       DateTime?
  sources           ArticleSource[]
  reviewStatus      ReviewStatus        @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([reviewStatus])
  @@index([contentType])
  @@index([authorProfileId])
  @@index([reviewerProfileId])
  @@map("articles")
}

model ContributorProfile {
  id                    String                 @id @default(uuid())
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind                  ContributorKind        @default(PERSON)
  slug                  String                 @unique
  displayName           String
  roleTitle             String?
  shortBio              String?
  bioBlocks             Json                   @default("[]")
  avatarUrl             String?
  thesisUrl             String?
  sameAs                String[]               @default([])
  isPublished           Boolean                @default(false)
  authoredArticles      Article[]              @relation("ArticleAuthor")
  reviewedArticles      Article[]              @relation("ArticleReviewer")
  authoredResources     Resource[]             @relation("ResourceAuthor")
  reviewedResources     Resource[]             @relation("ResourceReviewer")
  taughtCourses         CourseInstructor[]
  consultationOfferings ConsultationOffering[]
  consultationBookings  ConsultationBooking[]  @relation("ConsultationInstructor")
  coachPlans            CoachPlan[]            @relation("CoachPlanCoach")
  reviewedReports       WeeklyReport[]         @relation("WeeklyReportReviewer")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("contributor_profiles")
}

/// Who teaches a course, and on what share of its revenue.
///
/// An instructor is a ContributorProfile -- the same row that already backs
/// /authors/[slug] -- rather than a parallel entity, so one person has one
/// public identity whether they wrote an article, reviewed a resource or
/// taught a course.
model CourseInstructor {
  courseId             String
  course               Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contributorProfileId String
  contributorProfile   ContributorProfile @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)

  /// Basis points (10000 = 100%). Integer on purpose: instructor payouts are
  /// computed from this and a float cannot hold 32.5% exactly. The service
  /// rejects a set of shares on one course that sums above 10000.
  revenueShareBp Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@id([courseId, contributorProfileId])
  @@index([contributorProfileId])
  @@map("course_instructors")
}

model ContentSource {
  id                   String           @id @default(uuid())
  externalId           String?          @unique
  kind                 String
  title                String
  publisher            String
  creator              String?
  canonicalUrl         String
  deepUrl              String?
  sourceTier           String
  authorityScopes      String[]         @default([])
  sourceStatus         String           @default("ACTIVE")
  publishedAt          DateTime?
  issuedAt             DateTime?
  checkedAt            DateTime
  rightsHolder         String?
  rightsBasis          String           @default("LINK_ONLY")
  licenseName          String?
  licenseUrl           String?
  attributionText      String?
  mayLink              Boolean          @default(true)
  mayEmbed             Boolean          @default(false)
  mayQuote             Boolean          @default(false)
  mayReproduce         Boolean          @default(false)
  mayAdapt             Boolean          @default(false)
  mayTranslate         Boolean          @default(false)
  mayHost              Boolean          @default(false)
  commercialUseAllowed Boolean          @default(false)
  checksum             String?
  metadata             Json             @default("{}")
  archivedAt           DateTime?
  articleLinks         ArticleSource[]
  resourceLinks        ResourceSource[]
  universityRecords    University[]     @relation("UniversityOfficialSource")
  programRecords       Program[]        @relation("ProgramOfficialSource")
  capacityRecords      Capacity[]       @relation("CapacityOfficialSource")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([canonicalUrl])
  @@index([sourceStatus])
  @@map("content_sources")
}

model ArticleSource {
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sourceId  String
  source    ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  relation  String        @default("SUPPORTS")
  locator   String?
  claim     String?
  order     Int           @default(0)

  @@id([articleId, sourceId])
  @@index([sourceId])
  @@map("article_sources")
}

model Resource {
  id                String                 @id @default(uuid())
  externalId        String?                @unique
  slug              String                 @unique
  title             String
  summary           String
  description       String?
  kind              ResourceKind
  accessMode        AccessMode             @default(PUBLIC)
  hostingMode       ResourceHostingMode    @default(METADATA_ONLY)
  contentBlocks     Json                   @default("[]")
  externalUrl       String?
  sourceArtifactId  String?
  sourceArtifact    SourceArtifact?        @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  taxonomyDegrees   Degree[]               @default([])
  taxonomyFields    String[]               @default([])
  subjectCodes      String[]               @default([])
  topicCodes        String[]               @default([])
  provenance        Json?
  metadata          Json                   @default("{}")
  authorProfileId   String?
  authorProfile     ContributorProfile?    @relation("ResourceAuthor", fields: [authorProfileId], references: [id])
  reviewerProfileId String?
  reviewerProfile   ContributorProfile?    @relation("ResourceReviewer", fields: [reviewerProfileId], references: [id])
  reviewStatus      ReviewStatus           @default(DRAFT)
  version           Int                    @default(1)
  reviewedAt        DateTime?
  publishedAt       DateTime?
  sources           ResourceSource[]
  productGrants     ProductResourceGrant[]
  courseMaterials   CourseMaterial[]
  /// A free sample of this (paid) handout -- e.g. its first two chapters --
  /// that any signed-in student can read in the panel. The sample is its
  /// own published resource; this is only the pointer the handout page and
  /// the reader use to connect the two. Not versioned: it is a link, not text.
  sampleResourceId  String?
  sample            Resource?              @relation("ResourceSample", fields: [sampleResourceId], references: [id], onDelete: SetNull)
  sampleFor         Resource[]             @relation("ResourceSample")
  savedBy           SavedResource[]
  planTasks         Task[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([reviewStatus, accessMode])
  @@index([sourceArtifactId])
  @@index([authorProfileId])
  @@index([reviewerProfileId])
  @@map("resources")
}

model ResourceSource {
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sourceId   String
  source     ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  relation   String        @default("SUPPORTS")
  locator    String?
  claim      String?
  order      Int           @default(0)

  @@id([resourceId, sourceId])
  @@index([sourceId])
  @@map("resource_sources")
}

// ---------------------------------------------------------------------------
// Learning (doc §5.2): course/lesson content + enrollment + progress.
// Lesson content is intentionally simple blocks (text/heading/image/video-url)
// -- no upload/streaming infra yet, no LaTeX/rich question content (Phase 3).
// ---------------------------------------------------------------------------
model Course {
  id                   String                @id @default(uuid())
  slug                 String                @unique
  title                String
  description          String
  isPublished          Boolean               @default(false)
  accessMode           AccessMode            @default(ENTITLEMENT)
  subjectId            String?
  subject              Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  degreeTargets        Degree[]              @default([])
  fieldTargets         String[]              @default([])
  modules              CourseModule[]
  products             Product[]
  productGrants        ProductCourseGrant[]
  enrollments          Enrollment[]
  instructors          CourseInstructor[]
  /// The course id on SpotPlayer, the offline DRM player the videos live in.
  /// Null means this course has no video component.
  spotPlayerCourseId   String?
  /// The course's total length in minutes (its videos), set by the admin and
  /// shown on its card and page. Null when not stated.
  durationMinutes      Int?
  /// The cover image shown on the course card and page (uploaded by the
  /// admin). Null means the card draws a plain cover in the subject colour.
  coverArtifactId      String?
  coverArtifact        SourceArtifact?       @relation("CourseCover", fields: [coverArtifactId], references: [id], onDelete: SetNull)
  spotPlayerLicenses   SpotPlayerLicense[]
  videoLicenseRequests VideoLicenseRequest[]
  achievements         StudentAchievement[]
  materials            CourseMaterial[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([coverArtifactId])
  @@map("courses")
}

/// A handout (or other kept file) that comes with a course: whoever holds
/// access to the course -- bought directly or through a bundle -- may read
/// it, with no separate purchase. The resource can still be sold on its own
/// through a ProductResourceGrant. (Course -> Resource is one of the future
/// Knowledge Graph edges; this is its first concrete form.)
model CourseMaterial {
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([courseId, resourceId])
  @@index([resourceId])
  @@map("course_materials")
}

model CourseModule {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id             String           @id @default(uuid())
  courseModuleId String
  courseModule   CourseModule     @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  contentBlocks  Json
  /// [{ media_key, checksum }] for the image blocks in contentBlocks.
  assets         Json             @default("[]")
  isPreview      Boolean          @default(false)
  topics         LessonTopic[]
  progress       LessonProgress[]
  planTasks      Task[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([courseModuleId])
  @@map("lessons")
}

enum EnrollmentSource {
  PURCHASE
  GIFT
  MANUAL
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source     EnrollmentSource
  enrolledAt DateTime         @default(now())
  revokedAt  DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String    @id @default(uuid())
  userId       String
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// Commerce (doc §5.2/§8.1): the only source of truth for "is access active".
// Only COURSE-kind products exist in Phase 1 (nothing else is sellable yet --
// Study Pro/Mentor/Admissions packages need modules that don't exist until
// later phases). Coupons and subscriptions are deferred -- see AGENTS.md.
// No real payment gateway is chosen yet (doc §12.1), so PaymentProvider is a
// swappable interface with a "manual-sandbox" implementation for now, same
// pattern as the OTP provider in Phase 0.
// ---------------------------------------------------------------------------
enum ProductKind {
  COURSE
  RESOURCE
  BUNDLE
  // Phase 17 (doc/roadmap/LEARNING_GROWTH_ACCESS_AND_AEO.md §2.3): the
  // Question Bank is independently sellable, separate from any Course.
  QUESTION_BANK
  // A booked consultation with an instructor, single session or package.
  CONSULTATION
}

enum ConsultationKind {
  SINGLE_SESSION
  PACKAGE
}

/// REQUESTED  paid, student proposed times, waiting on the instructor
/// CONFIRMED  instructor fixed a time
/// COMPLETED  the session happened
/// CANCELLED  called off by either side; returns the session to the quota
/// NO_SHOW    booked time passed unused; consumes the quota
enum ConsultationBookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// What an instructor sells: one session, or a package of sessions with a
/// deadline (the "annual until konkur" product).
///
/// Backed by a Product so the price, order, payment and entitlement all come
/// from the commerce tables that already exist rather than a second, parallel
/// payment path.
model ConsultationOffering {
  id                  String                @id @default(uuid())
  instructorProfileId String
  instructorProfile   ContributorProfile    @relation(fields: [instructorProfileId], references: [id], onDelete: Restrict)
  productId           String                @unique
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind                ConsultationKind
  /// Sessions included. The booking service counts bookings down against it.
  sessionQuota        Int                   @default(1)
  durationMinutes     Int                   @default(45)
  /// The deadline the package runs to -- the konkur date. Copied onto the
  /// entitlement's endAt at checkout, so expiry is evaluated by AccessService
  /// like every other entitlement rather than by a rule of its own.
  validUntil          DateTime?
  headline            String
  description         String
  isActive            Boolean               @default(true)
  bookings            ConsultationBooking[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([instructorProfileId])
  @@map("consultation_offerings")
}

/// One session drawn against what a student bought.
///
/// There is no availability calendar on purpose: the student proposes times,
/// the instructor confirms one of them or any other time, and the student can
/// cancel if it does not suit.
model ConsultationBooking {
  id                  String                    @id @default(uuid())
  offeringId          String
  offering            ConsultationOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  /// What paid for this session. Quota is counted per entitlement, so buying
  /// the same package twice gives two independent quotas.
  entitlementId       String
  entitlement         Entitlement               @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  studentUserId       String
  student             User                      @relation("ConsultationStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  /// Denormalized from the offering so an instructor's queue never joins
  /// through it, and a booking keeps naming whoever actually took it.
  instructorProfileId String
  instructorProfile   ContributorProfile        @relation("ConsultationInstructor", fields: [instructorProfileId], references: [id], onDelete: Restrict)
  status              ConsultationBookingStatus @default(REQUESTED)
  /// Times the student proposed, as ISO strings.
  requestedSlots      Json                      @default("[]")
  studentNote         String?
  scheduledAt         DateTime?
  durationMinutes     Int
  /// Meeting link, or a note for a phone or in-person session. Only ever
  /// projected to the two participants.
  meetingUrl          String?
  instructorNote      String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([instructorProfileId, status])
  @@index([studentUserId])
  @@index([entitlementId])
  @@map("consultation_bookings")
}

model Product {
  id                   String                     @id @default(uuid())
  slug                 String                     @unique
  title                String
  description          String
  kind                 ProductKind
  courseId             String?
  course               Course?                    @relation(fields: [courseId], references: [id])
  isActive             Boolean                    @default(true)
  prices               Price[]
  orderItems           OrderItem[]
  entitlements         Entitlement[]
  courseGrants         ProductCourseGrant[]
  resourceGrants       ProductResourceGrant[]
  questionBankGrants   ProductQuestionBankGrant[]
  consultationOffering ConsultationOffering?
  discountCodes        DiscountCodeProduct[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@map("products")
}

model ProductCourseGrant {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([productId, courseId])
  @@index([courseId])
  @@map("product_course_grants")
}

model ProductResourceGrant {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([productId, resourceId])
  @@index([resourceId])
  @@map("product_resource_grants")
}

// Phase 17 (doc/roadmap/LEARNING_GROWTH_ACCESS_AND_AEO.md §2-3): bank access
// is SUBJECT-scoped (owner decision) -- a grant unlocks "the question bank
// for subject X", not the whole bank and not per-topic. A Course product can
// carry one of these alongside its ProductCourseGrant(s) so purchasing the
// course includes the related bank at no extra charge, and the bank stays
// independently sellable as its own QUESTION_BANK product.
//
// Scoped by `subjectCode` (a plain string), matching Question.subjectCode --
// not a Subject.id foreign key. Question/Article never FK to Subject (see
// the "Taxonomy" comment above the Subject model below); a grant that FK'd
// to Subject while the questions it gates stayed loose-stringed would be an
// inconsistent hybrid, and would require every subject used in ingested
// question data to first exist as a catalog row.
model ProductQuestionBankGrant {
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  subjectCode String

  @@id([productId, subjectCode])
  @@index([subjectCode])
  @@map("product_question_bank_grants")
}

model Price {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountRial    Int
  /// The price before a sale, shown struck through beside amountRial; null when there is no sale.
  compareAtRial Int?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]

  @@index([productId])
  @@map("prices")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus   @default(PENDING)
  /// What the buyer pays: the items' price minus discountRial.
  totalAmountRial Int
  /// Taken off by a discount code; 0 without one.
  discountRial    Int           @default(0)
  discountCodeId  String?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([discountCodeId])
  @@map("orders")
}

/// A code a buyer types at checkout for money off: a percentage or a fixed
/// amount, on every product or only the listed ones, within an optional
/// date window and usage limits. An order counts against the limits while it
/// is open or paid; a cancelled one gives its use back.
model DiscountCode {
  id             String                @id @default(uuid())
  /// Stored upper-case; matched without regard to case.
  code           String                @unique
  /// For the admin: what the code is for (a channel campaign, a friend).
  note           String?
  percentOff     Int?
  amountOffRial  Int?
  startsAt       DateTime?
  endsAt         DateTime?
  /// Total uses across all buyers; null for no limit.
  maxRedemptions Int?
  maxPerUser     Int                   @default(1)
  isActive       Boolean               @default(true)
  /// Empty means every product.
  products       DiscountCodeProduct[]
  orders         Order[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("discount_codes")
}

model DiscountCodeProduct {
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountCodeId, productId])
  @@index([productId])
  @@map("discount_code_products")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  priceId    String
  price      Price   @relation(fields: [priceId], references: [id])
  quantity   Int     @default(1)
  amountRial Int

  @@index([orderId])
  @@map("order_items")
}

/// PENDING          order opened, nothing transferred yet
/// AWAITING_REVIEW  buyer says they transferred and gave a tracking code
/// SUCCEEDED        an operator matched it against the bank statement
/// REJECTED         checked and not found, or did not match
/// FAILED           kept for the online-gateway path
enum PaymentStatus {
  PENDING
  AWAITING_REVIEW
  SUCCEEDED
  REJECTED
  FAILED
}

/// A destination card for card-to-card transfers, managed from the admin
/// panel. These are the seller's own published numbers, shown to buyers, but
/// only an active one is ever offered so a closed account cannot keep taking
/// money.
model BankAccount {
  id         String    @id @default(uuid())
  bankName   String
  holderName String
  /// Digits only; formatting is a display concern.
  cardNumber String    @unique
  iban       String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  payments   Payment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
  @@map("bank_accounts")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String        @unique
  status      PaymentStatus @default(PENDING)
  amountRial  Int
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  /// Where the buyer was told to send the money.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// The short code the buyer puts in the transfer description and the
  /// operator matches against the statement. Unique, so one code never
  /// stands for two orders.
  referenceCode String? @unique

  /// The buyer's own claim about the transfer. Unverified until an operator
  /// confirms it, which is why none of it grants anything by itself.
  receiptTrackingCode  String?
  receiptPaidAt        DateTime?
  receiptFromCardLast4 String?
  receiptNote          String?
  receiptSubmittedAt   DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

enum EntitlementGrantSource {
  ORDER
  GIFT
  MANUAL
  TRIAL
}

model Entitlement {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation("EntitlementUser", fields: [userId], references: [id], onDelete: Cascade)
  productId            String
  product              Product                @relation(fields: [productId], references: [id])
  grantedVia           EntitlementGrantSource
  reason               String?
  grantedByUserId      String?
  startAt              DateTime               @default(now())
  endAt                DateTime?
  revokedAt            DateTime?
  createdAt            DateTime               @default(now())
  consultationBookings ConsultationBooking[]

  @@index([userId])
  @@index([productId])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// Content: minimal canonical tables for ingested question.v1 / report-card.v1
// data (doc §6.1). Deliberately thin -- just enough structure to prove the
// ingestion pipeline publishes real, queryable, versioned rows. Rich modeling
// (normalized Topic/Tag/Option entities, full-text search, a block renderer)
// is Phase 3's Content Engine; this table's shape does not need to survive
// that rewrite unchanged.
// ---------------------------------------------------------------------------
/// How far a question has been checked. A student only ever sees SILVER or
/// GOLD; DRAFT waits in the admin review queue (text or key not yet compared
/// with the original booklet). GOLD also has a worked solution. Derived on
/// publish and on review, never typed by hand.
enum QuestionQuality {
  GOLD
  SILVER
  DRAFT
}

/// How sure a student was before answering: chosen with the answer, optional.
enum AnswerConfidence {
  SURE
  TWO_WAY
  GUESS
}

/// Why a student got a question wrong, in their own judgement after reading the key.
enum PracticeErrorReason {
  DID_NOT_KNOW
  CARELESS
  CALCULATION
  OUT_OF_TIME
  TRAP_OPTION
}

/// What an answer earned. VOID: the final key deleted the question.
enum PracticeOutcome {
  CORRECT
  WRONG
  VOID
}

/// One answer a student gave while practising a bank question, outside an
/// exam. The outcome is computed on the server from the key at that moment.
/// A question's history (seen three times, wrong the last two) and the smart
/// collections (never right, wrong the last two, sure but wrong) read these.
model PracticeAnswer {
  id             String               @id @default(uuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Int
  outcome        PracticeOutcome
  confidence     AnswerConfidence?
  errorReason    PracticeErrorReason?
  timeSpentMs    Int?
  createdAt      DateTime             @default(now())

  @@index([userId, questionId, createdAt])
  @@index([userId, createdAt])
  @@map("practice_answers")
}

/// A student's own star and note on a bank question.
model QuestionMark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  starred    Boolean  @default(false)
  note       String?
  updatedAt  DateTime @updatedAt

  @@id([userId, questionId])
  @@index([userId, starred])
  @@map("question_marks")
}

/// How the final key scores a question. DELETED: the exam board removed it --
/// no mark either way and not counted (correctOption keeps the earlier key,
/// for reference). POSITIVE_EFFECT: a right answer scores, a wrong one costs
/// nothing.
enum QuestionKeyState {
  NORMAL
  DELETED
  POSITIVE_EFFECT
}

/// Text shared by several questions -- the reading passage of the English
/// section -- stored once and shown above each of its questions.
model QuestionPassage {
  id         String     @id @default(uuid())
  externalId String     @unique
  blocks     Json
  questions  Question[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("question_passages")
}

model Question {
  id               String           @id @default(uuid())
  externalId       String           @unique
  examDegree       Degree
  examMajor        String
  examYear         Int
  // Where the question sits in the real booklet: exam code (1277), booklet,
  // number and printed section. Lets a past exam be replayed in its order.
  examCode         String?
  bookletNumber    Int?
  questionNumber   Int?
  sectionTitle     String?
  subjectCode      String
  topicCodes       String[]
  passageId        String?
  passage          QuestionPassage? @relation(fields: [passageId], references: [id])
  stemBlocks       Json
  options          Json
  correctOption    Int
  // Every option the final key accepts. Empty means just correctOption; the
  // exam board sometimes accepts two after an objection.
  acceptedOptions  Int[]            @default([])
  keyState         QuestionKeyState @default(NORMAL)
  solutionBlocks   Json
  // The two lighter layers of a worked solution (question.v2 hint, shortcut):
  // a nudge before answering, and the quick way under exam time.
  solutionHint     String?
  solutionShortcut String?
  textVerified     Boolean          @default(true)
  keyVerified      Boolean          @default(true)
  qualityTier      QuestionQuality  @default(SILVER)
  assets           Json             @default("[]")
  source           Json?
  provenance       Json
  version          Int              @default(1)
  // Phase 17 (doc/roadmap/LEARNING_GROWTH_ACCESS_AND_AEO.md §2.1): admin-set
  // flag -- NOT auto-selected. A sample question is fully public, including
  // `correctOption`/`solutionBlocks`: it is the shop-window/AEO asset for its
  // subject. Everything not flagged is gated behind subject bank access
  // (question-bank.service.ts). Defaults to false so every existing and
  // newly-ingested question stays gated until an admin deliberately flags
  // it, from the bank screen in the admin panel. Retiring a question clears
  // this flag: a retired question must not keep acting as a shop-window.
  isSample         Boolean          @default(false)
  // A retired question leaves the bank and can no longer be added to an exam,
  // but the row stays: ExamItem and Answer reference it without a cascade, so
  // deleting one that has ever been sat is refused by the database, and even
  // where a delete would succeed it would destroy what a past attempt's report
  // renders from. Reads filter on this rather than on a boolean so the panel
  // can also show when, and `retiredReason` records why.
  retiredAt        DateTime?
  retiredReason    String?
  examItems        ExamItem[]
  practiceAnswers  PracticeAnswer[]
  marks            QuestionMark[]
  answers          Answer[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([subjectCode])
  @@index([subjectCode, isSample])
  @@index([retiredAt])
  @@index([subjectCode, retiredAt])
  @@index([qualityTier])
  @@index([examYear, examCode])
  @@map("questions")
}

model ReportCard {
  id            String   @id @default(uuid())
  externalId    String   @unique
  anonymousId   String
  examYear      Int
  degree        Degree
  field         String
  quota         String
  subjectScores Json
  rank          Json
  admissions    Json
  provenance    Json
  version       Int      @default(1)
  publicConsent Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([examYear, degree, field])
  @@map("report_cards")
}

// ---------------------------------------------------------------------------
// Ingestion (doc §5.2/§6.2): the only path from external JSON/ZIP to canonical
// data. Receive -> Schema -> Staging -> Normalize -> Assets -> Deduplicate ->
// Domain QA -> Review -> Publish. No external tool ever writes to Article/
// Question/ReportCard directly -- only IngestionService.publish() does, and
// only for items an ImportItem review approved.
// ---------------------------------------------------------------------------
enum ImportJobStatus {
  RECEIVED
  STAGED
  REVIEWED
  PUBLISHED
  FAILED
}

model ImportJob {
  id             String          @id @default(uuid())
  schemaVersion  String
  idempotencyKey String          @unique
  status         ImportJobStatus @default(RECEIVED)
  submittedBy    String?
  totalItems     Int             @default(0)
  items          ImportItem[]
  createdAt      DateTime        @default(now())

  @@map("import_jobs")
}

enum ImportItemStatus {
  PENDING
  VALID
  INVALID
  APPROVED
  REJECTED
  PUBLISHED
}

enum DedupeStatus {
  NEW
  MATCH
  CONFLICT
}

model ImportItem {
  id                String           @id @default(uuid())
  importJobId       String
  importJob         ImportJob        @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  externalId        String
  rawPayload        Json
  status            ImportItemStatus @default(PENDING)
  validationErrors  Json             @default("[]")
  dedupeStatus      DedupeStatus?
  publishedEntityId String?
  publishedVersion  Int?
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())

  @@index([importJobId])
  @@index([status])
  @@map("import_items")
}

model SourceArtifact {
  id                String               @id @default(uuid())
  checksum          String               @unique
  filename          String
  mimeType          String
  size              Int
  storageKey        String
  createdAt         DateTime             @default(now())
  resources         Resource[]
  achievementPhotos StudentAchievement[]
  courseCovers      Course[]             @relation("CourseCover")

  @@map("source_artifacts")
}

// Generic version history so any ingested entity (article/question/report
// card) can be rolled back to a prior snapshot without a per-domain
// versions table. Rollback creates a NEW version copying an old snapshot's
// payload rather than destroying history (doc §10.2: "بازگشت نسخه بدون خرابی").
enum VersionedEntityType {
  ARTICLE
  QUESTION
  REPORT_CARD
  RESOURCE
}

model ContentVersion {
  id                      String              @id @default(uuid())
  entityType              VersionedEntityType
  entityId                String
  version                 Int
  payload                 Json
  schemaVersion           String              @default("article.v1")
  reviewStatus            ReviewStatus        @default(PUBLISHED)
  createdByUserId         String?
  reviewedByUserId        String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewNote              String?
  publishedAt             DateTime?
  publishedByImportItemId String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("content_versions")
}

// ---------------------------------------------------------------------------
// Taxonomy (doc §6.1, phase 3 deliverable): canonical Subject/Topic catalog.
// Question.subjectCode/topicCodes and Article.taxonomyMajor/taxonomyTags stay
// as plain strings (that's the shape the article.v1/question.v1 contracts
// fix) -- this catalog is what a Topic-browsing UI reads, and what content
// authoring validates codes against; it is not wired as a foreign key onto
// the ingested tables themselves.
// ---------------------------------------------------------------------------
model Subject {
  id              String                @id @default(uuid())
  code            String                @unique
  title           String
  slug            String                @unique
  description     String?
  order           Int                   @default(0)
  metadata        Json                  @default("{}")
  topics          Topic[]
  courses         Course[]
  prerequisites   SubjectPrerequisite[] @relation("SubjectPrerequisites")
  prerequisiteFor SubjectPrerequisite[] @relation("SubjectPrerequisiteFor")
  createdAt       DateTime              @default(now())

  @@map("subjects")
}

model Topic {
  id              String              @id @default(uuid())
  code            String              @unique
  title           String
  slug            String              @unique
  description     String?
  order           Int                 @default(0)
  metadata        Json                @default("{}")
  subjectId       String
  subject         Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonLinks     LessonTopic[]
  prerequisites   TopicPrerequisite[] @relation("TopicPrerequisites")
  prerequisiteFor TopicPrerequisite[] @relation("TopicPrerequisiteFor")
  createdAt       DateTime            @default(now())

  @@index([subjectId])
  @@map("topics")
}

model SubjectPrerequisite {
  subjectId      String
  prerequisiteId String
  subject        Subject @relation("SubjectPrerequisites", fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisite   Subject @relation("SubjectPrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([subjectId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("subject_prerequisites")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  topic          Topic  @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   Topic  @relation("TopicPrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}

model LessonTopic {
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
  @@index([topicId])
  @@map("lesson_topics")
}

// ---------------------------------------------------------------------------
// Assessment (doc §5.2/§6.1, phase 4): the only place scores/answers are
// authoritative. Exam is the blueprint; ExamForm is one concrete, ordered set
// of questions (STATIC exams reuse one shared form; DYNAMIC exams get a
// fresh, randomly-drawn form per attempt -- simpler to reason about than a
// shared adaptive pool, and still meaningfully "dynamic").
// ---------------------------------------------------------------------------
enum ExamMode {
  STATIC
  DYNAMIC
}

model Exam {
  id                String        @id @default(uuid())
  slug              String        @unique
  title             String
  description       String
  mode              ExamMode
  durationMinutes   Int
  // DYNAMIC-mode selection rule: draw questionCount random published
  // questions matching subjectCode. Not used for STATIC exams.
  subjectCode       String?
  questionCount     Int?
  isPublished       Boolean       @default(false)
  createdBy         String?
  // A simulator replays one real exam (code + year) in its booklet order;
  // its report card can then place the student against that year's results.
  simulatesExamCode String?
  simulatesYear     Int?
  // A student's own practice exam (built from the bank by topic): never
  // published, only its owner may sit it.
  ownerUserId       String?
  forms             ExamForm[]
  sections          ExamSection[]
  attempts          Attempt[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([ownerUserId])
  @@map("exams")
}

model ExamForm {
  id        String     @id @default(uuid())
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  items     ExamItem[]
  attempts  Attempt[]
  createdAt DateTime   @default(now())

  @@index([examId])
  @@map("exam_forms")
}

/// A scored part of an exam -- the konkur's «درس امتحانی». The report card
/// gives each its own percentage and standard score; rankBox names the box of
/// the 1277 rank model it stands for, so a simulator can estimate a rank.
model ExamSection {
  id          String     @id @default(uuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  rankBox     String?
  coefficient Float      @default(1)
  items       ExamItem[]

  @@index([examId])
  @@map("exam_sections")
}

model ExamItem {
  id         String       @id @default(uuid())
  examFormId String
  examForm   ExamForm     @relation(fields: [examFormId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id])
  order      Int
  points     Float        @default(1)
  sectionId  String?
  section    ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([examFormId, questionId])
  @@index([examFormId])
  @@map("exam_items")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id          String        @id @default(uuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id])
  examFormId  String
  examForm    ExamForm      @relation(fields: [examFormId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  answers     Answer[]
  score       Score?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([examId])
  @@map("attempts")
}

model Answer {
  id             String   @id @default(uuid())
  attemptId      String
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  selectedOption Int?
  answeredAt     DateTime @default(now())
  // How the student worked, for the report card's time and strategy view.
  timeSpentMs    Int      @default(0)
  flagged        Boolean  @default(false)
  changeCount    Int      @default(0)

  @@unique([attemptId, questionId])
  @@map("answers")
}

// scoreVersion makes every score reproducible/auditable even if the scoring
// rule changes later (doc's "estimator_version"-style discipline, applied
// here to grading instead of rank estimation).
model Score {
  id              String   @id @default(uuid())
  attemptId       String   @unique
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scoreVersion    String
  correctCount    Int
  wrongCount      Int
  unansweredCount Int
  rawScore        Float
  percentCorrect  Float
  /// Per-section results frozen at grading, so a later edit to the exam
  /// cannot quietly change an issued report card.
  breakdown       Json?
  computedAt      DateTime @default(now())

  @@map("scores")
}

// Transactional Outbox (doc §5.1): domain changes and their events are written
// in the same DB transaction. No consumer exists yet in Phase 0 -- later phases
// ---------------------------------------------------------------------------
// Planning (doc §5.2/§6.1, phase 5): consumes Mastery, produces activity. One
// active Goal per user for now (a student changes their goal in place rather
// than juggling several); Plan/Task/StudySession are Planning's own; Mastery
// belongs to Analytics per doc's module table, but this is the only slice of
// Analytics phase 5 needs (Benchmark/Prediction are Phase 6's rank engine).
// ---------------------------------------------------------------------------
model Goal {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree            Degree
  field             String
  targetExamDate    DateTime?
  weeklyHours       Int
  selfReportedLevel SelfReportedLevel @default(UNKNOWN)
  plans             Plan[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("goals")
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

model Plan {
  id                    String            @id @default(uuid())
  goalId                String
  goal                  Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId                String
  goalDegree            Degree
  goalField             String
  goalWeeklyHours       Int
  goalTargetExamDate    DateTime?
  goalSelfReportedLevel SelfReportedLevel
  status                PlanStatus        @default(ACTIVE)
  version               Int               @default(1)
  tasks                 Task[]
  revisions             PlanRevision[]
  createdAt             DateTime          @default(now())

  @@index([userId])
  @@index([userId, status])
  @@map("plans")
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model Task {
  id               String     @id @default(uuid())
  planId           String
  plan             Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  lessonId         String?
  lesson           Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  resourceId       String?
  resource         Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  subjectCode      String
  topicCode        String?
  title            String
  estimatedMinutes Int
  scheduledFor     DateTime
  priority         Int
  reasonCode       String
  status           TaskStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  @@unique([planId, lessonId])
  @@unique([planId, resourceId])
  @@index([planId])
  @@index([planId, scheduledFor])
  @@index([lessonId])
  @@index([resourceId])
  @@map("tasks")
}

model SavedResource {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  savedAt     DateTime  @default(now())
  plannedAt   DateTime?
  completedAt DateTime?

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("saved_resources")
}

// Every (re)plan action is recorded here -- doc §10.2 Phase 5 DoD:
// "reason_code، تاریخچه تغییر" (reason_code, change history).
model PlanRevision {
  id         String   @id @default(uuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reasonCode String
  summary    String
  createdAt  DateTime @default(now())

  @@index([planId])
  @@map("plan_revisions")
}

enum StudySessionSource {
  UNCLASSIFIED_LEGACY
  MANUAL
  TASK_ACTUAL
}

model StudySession {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode String
  topicCode   String?
  minutes     Int
  taskId      String?
  source      StudySessionSource @default(MANUAL)
  loggedAt    DateTime           @default(now())

  @@index([userId])
  @@map("study_sessions")
}

// Deterministic, versioned, rule-based -- doc §7: "وزن‌دهی صحت، سختی، تازگی و
// تعداد شواهد با فرمول ثابت" (weight correctness, difficulty, recency, and
// evidence count with a fixed formula). Never a black-box/ML estimate.
model MasteryState {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode   String
  topicCode     String
  masteryScore  Float
  confidence    String
  evidenceCount Int
  ruleVersion   String
  computedAt    DateTime @default(now())

  @@unique([userId, topicCode])
  @@index([userId])
  @@map("mastery_states")
}

// (Planning/CRM/Notification) add a poller/dispatcher that reads unpublished rows.
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([eventType])
  @@index([publishedAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Admissions (doc §2's module list): university/program/capacity catalog +
// a student's ordered choice list. Depends on Analytics (below) to show an
// acceptance chance per program; never the other way around.
// ---------------------------------------------------------------------------
enum TuitionType {
  FREE
  PAID
}

model University {
  id        String         @id @default(uuid())
  code      String         @unique
  title     String
  city      String
  sourceId  String?
  source    ContentSource? @relation("UniversityOfficialSource", fields: [sourceId], references: [id], onDelete: Restrict)
  programs  Program[]
  createdAt DateTime       @default(now())

  @@index([sourceId])
  @@map("universities")
}

model Program {
  id               String           @id @default(uuid())
  universityId     String
  university       University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  code             String           @unique
  title            String
  degree           Degree
  field            String
  tuitionType      TuitionType
  hasDormitory     Boolean          @default(false)
  /// Field-selection booklet facts. Null on programs entered by hand before
  /// the booklet import existed.
  /// The exam set (مجموعهٔ امتحانی) whose rank admits, e.g. "1277".
  examSetCode      String?
  /// The booklet's coefficient code (کد ضریب) within that set.
  coefficientGroup Int?
  /// The programme without the field's own name, e.g. «نرم‌افزار».
  orientation      String?
  period           StudyPeriod?
  /// Study place when the booklet names one besides the institution, e.g. «پردیس فارابی قم».
  location         String?
  /// City of study (not necessarily the institution's main city).
  city             String?
  gender           ProgramGender    @default(ANY)
  sourceId         String?
  source           ContentSource?   @relation("ProgramOfficialSource", fields: [sourceId], references: [id], onDelete: Restrict)
  capacities       Capacity[]
  choiceItems      ChoiceListItem[]
  createdAt        DateTime         @default(now())

  @@index([degree, field])
  @@index([examSetCode, period])
  @@index([sourceId])
  @@map("programs")
}

/// دورهٔ تحصیلی in Sanjesh's booklet; only DAILY is tuition-free.
enum StudyPeriod {
  DAILY
  EVENING
  SELF_FUNDED_CAMPUS
  VIRTUAL
  NON_PROFIT
  VIRTUAL_NON_PROFIT
  PAYAM_NOOR
  VIRTUAL_PAYAM_NOOR
}

enum ProgramGender {
  ANY
  FEMALE
  MALE
}

model Capacity {
  id            String         @id @default(uuid())
  programId     String
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  examYear      Int
  quota         String
  capacity      Int
  /// کد رشته‌محل in that year's booklet: what a candidate types into Sanjesh's form.
  selectionCode String?
  /// The booklet's «توضیحات» for that year, as printed.
  notes         String?
  bookletPage   Int?
  sourceId      String?
  source        ContentSource? @relation("CapacityOfficialSource", fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([programId, examYear, quota])
  @@index([examYear, selectionCode])
  @@index([sourceId])
  @@map("capacities")
}

model ChoiceList {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ChoiceListItem[]
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@map("choice_lists")
}

model ChoiceListItem {
  id           String     @id @default(uuid())
  choiceListId String
  choiceList   ChoiceList @relation(fields: [choiceListId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id])
  priority     Int

  @@unique([choiceListId, programId])
  @@index([choiceListId])
  @@map("choice_list_items")
}

// ---------------------------------------------------------------------------
// Analytics -- Benchmark/Prediction slice (doc §6.1/§6.5/§7): a k-nearest-
// neighbor rank estimate against real, approved ReportCard comparables.
// Never a bare number -- always median + interval + confidence + comparables
// + methodology + per-subject sensitivity, versioned and backtestable.
// ---------------------------------------------------------------------------
model RankEstimate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimatorVersion String
  degree           Degree
  field            String
  quota            String
  subjectScores    Json
  rankMedian       Int
  rankP50Low       Int
  rankP50High      Int
  rankP80Low       Int
  rankP80High      Int
  confidence       String
  comparableCount  Int
  comparableYears  Int[]
  sensitivity      Json
  methodology      String
  generatedAt      DateTime @default(now())

  @@index([userId])
  @@map("rank_estimates")
}

// doc's Phase 6 DoD: "Backtest، گزارش خطا" -- run the same estimator against
// known historical report cards and record how well its intervals actually
// covered the real outcome (doc §11's "Prediction Calibration" metric).
model BacktestReport {
  id                  String   @id @default(uuid())
  estimatorVersion    String
  sampleSize          Int
  coverageP50         Float
  coverageP80         Float
  meanAbsPercentError Float
  computedAt          DateTime @default(now())

  @@map("backtest_reports")
}

// ---------------------------------------------------------------------------
// CRM (doc §5.2/§8.2): support data; never mutates score/access directly.
// Lead.stage follows doc's funnel: Lead -> Activated -> At Risk -> Qualified
// -> Customer -> Advocate. The Lead row itself is created by a real outbox
// consumer (the first one in this codebase -- see AnalyticsModule... no,
// CrmModule -- for OutboxEvent "UserOnboarded"), closing a gap noted since
// Phase 0/1 ("no consumer exists yet").
// ---------------------------------------------------------------------------
enum LeadStage {
  LEAD
  ACTIVATED
  AT_RISK
  QUALIFIED
  CUSTOMER
  ADVOCATE
}

model Lead {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage        LeadStage     @default(LEAD)
  source       String?
  campaignCode String?
  cases        Case[]
  interactions Interaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([stage])
  @@map("leads")
}

enum CaseStatus {
  OPEN
  RESOLVED
}

model Case {
  id         String     @id @default(uuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject    String
  status     CaseStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  @@index([leadId])
  @@map("cases")
}

model Interaction {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  note      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("interactions")
}

// Telegram growth loop (doc §8.3): every deep link carries a campaign_id +
// content_id; GET /r/:code attributes the click and forwards the visitor,
// and the resulting signup's Lead carries the same campaignCode.
model Campaign {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  targetUrl String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@map("campaigns")
}

/// A SpotPlayer licence issued to one student for one course.
///
/// SpotPlayer is an offline DRM player: the student installs the app and
/// enters a key issued to them personally. It will happily issue a second
/// licence for the same person, and each one is a separate seat, so the
/// unique pair below is what stops a refresh or a retry from spending one.
model SpotPlayerLicense {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// SpotPlayer's own id, kept so the licence can be edited or revoked there.
  spotPlayerLicenseId String
  /// What the student types into the player, and the link that comes with it.
  licenseKey          String
  licenseUrl          String
  issuedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("spot_player_licenses")
}

/// A Telegram account linked to a site account, so the Telegram mini app
/// signs its owner in by itself. Linked once, after a normal sign-in inside
/// the mini app; the signed init data from Telegram proves the Telegram side.
model TelegramAccount {
  telegramId String   @id
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String?
  firstName  String?
  linkedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@map("telegram_accounts")
}

/// The owner signing off a guide whose text lives in the site code (static
/// guides). Until a guide has one it names no reviewer.
model GuideReview {
  slug         String   @id
  reviewerId   String?
  reviewerName String
  reviewedAt   DateTime @default(now())

  @@map("guide_reviews")
}

/// The one SpotPlayer licence the owner issues a student by hand (owner,
/// 2026-10-11: no API issuance). One key can cover every course the student
/// has, so it belongs to the student, not to a course.
model StudentVideoLicense {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseKey String
  issuedById String?
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("student_video_licenses")
}

enum VideoLicenseRequestStatus {
  PENDING
  DONE
}

/// A student asking for a course's videos: the owner adds the course to the
/// student's licence on SpotPlayer and marks it done here.
model VideoLicenseRequest {
  id          String                    @id @default(uuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status      VideoLicenseRequestStatus @default(PENDING)
  requestedAt DateTime                  @default(now())
  handledAt   DateTime?
  handledById String?

  @@unique([userId, courseId])
  @@index([status, requestedAt])
  @@map("video_license_requests")
}

/// A named, consented result of one of the owner's own students -- the
/// homepage results wall.
///
/// Separate from ReportCard on purpose: that is the anonymous dataset behind
/// rank estimation and carries no name or photo. This is a real person shown
/// because they agreed to be. The database refuses `isPublished` without
/// `consentConfirmedAt`, so no code path can publish someone who did not.
model StudentAchievement {
  id                 String          @id @default(uuid())
  displayName        String
  photoArtifactId    String?
  photoArtifact      SourceArtifact? @relation(fields: [photoArtifactId], references: [id], onDelete: SetNull)
  examYear           Int
  degree             Degree
  field              String
  rank               Int
  /// What the rank is a rank of -- national, quota, region.
  rankLabel          String?
  acceptedUniversity String?
  acceptedProgram    String?
  quote              String?
  /// Subjects this student took with the owner, by subject slug.
  subjectSlugs       String[]        @default([])
  courseId           String?
  course             Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  videoUrl           String?
  /// Where the result was first announced, e.g. the owner's channel post.
  sourceUrl          String?
  /// When consent to be shown publicly was obtained. Internal.
  consentConfirmedAt DateTime?
  /// How consent was obtained. Never leaves the admin panel.
  consentNote        String?
  isPublished        Boolean         @default(false)
  isFeatured         Boolean         @default(false)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([isPublished, examYear])
  @@index([photoArtifactId])
  @@map("student_achievements")
}

enum CoachPlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CoachTaskKind {
  STUDY
  TEST
  REVIEW
  VIDEO
  EXAM
  OTHER
}

/// A study plan a consultant writes for one student they advise. Only an
/// instructor with a (non-cancelled) consultation booking from the student
/// may create one; see CoachPlansService.assertCoachOf.
model CoachPlan {
  id             String             @id @default(uuid())
  studentUserId  String
  student        User               @relation("CoachPlanStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  coachProfileId String
  coach          ContributorProfile @relation("CoachPlanCoach", fields: [coachProfileId], references: [id], onDelete: Restrict)
  title          String
  startsOn       DateTime           @db.Date
  endsOn         DateTime           @db.Date
  note           String?
  status         CoachPlanStatus    @default(DRAFT)
  publishedAt    DateTime?
  items          CoachPlanItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([studentUserId, status])
  @@index([coachProfileId])
  @@map("coach_plans")
}

model CoachPlanItem {
  id            String        @id @default(uuid())
  planId        String
  plan          CoachPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  day           DateTime      @db.Date
  kind          CoachTaskKind @default(STUDY)
  title         String
  /// Editorial subject slug, for the subject's icon and colour.
  subjectSlug   String?
  targetMinutes Int?
  /// e.g. the number of test questions to solve.
  targetCount   Int?
  /// A page on this site: a lesson, resource, exam or topic.
  href          String?
  note          String?
  order         Int           @default(0)
  completedAt   DateTime?
  actualMinutes Int?
  studentNote   String?

  @@index([planId, day])
  @@map("coach_plan_items")
}

/// The student's own account of one week (Saturday to Friday, Tehran), filled
/// in before the weekly consultation session. Study minutes and exam results
/// are not stored here: they are read from StudySession and Attempt for the
/// same week, so the report never disagrees with what was logged.
model WeeklyReport {
  id                  String              @id @default(uuid())
  studentUserId       String
  student             User                @relation("WeeklyReportStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  /// The Saturday that starts the week.
  weekStart           DateTime            @db.Date
  testsSolved         Int                 @default(0)
  /// How the week felt, 1 (very low) to 5 (very good).
  energy              Int?
  wentWell            String?
  obstacles           String?
  questions           String?
  submittedAt         DateTime?
  /// The consultant's feedback after reviewing it, shown to the student.
  coachNote           String?
  reviewedAt          DateTime?
  reviewedByProfileId String?
  reviewedBy          ContributorProfile? @relation("WeeklyReportReviewer", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([studentUserId, weekStart])
  @@map("weekly_reports")
}
