DATABASE_URL="postgresql://konkur:konkur@localhost:5432/konkurcom?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=konkur
S3_SECRET_KEY=konkur123
S3_BUCKET=konkurcom-media

# Optional one-time administrator bootstrap. Leave both unset to disable it.
# Never commit real production values.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# SpotPlayer (offline DRM video). Copy the key from the SpotPlayer panel
# dashboard. Leave unset to run without video: courses then report that the
# integration is not configured instead of issuing licences that open nothing.
SPOTPLAYER_API_KEY=

# SMS gateway for login codes and notifications. Leave SMS_PROVIDER unset in
# development: codes and messages are then only written to the API log.
# Every message uses a template approved in the gateway's panel:
#   kavenegar -- template names; variables go in token, token2, token3
#   smsir     -- numeric template ids; the login template uses #CODE#, the
#                others #TOKEN#, #TOKEN2#, #TOKEN3#
SMS_PROVIDER=
SMS_API_KEY=
SMS_OTP_TEMPLATE=
# Phones (comma-separated, e.g. 09121234567) told when a card-to-card receipt arrives.
SMS_ADMIN_PHONES=
# One template per notification; a kind without one is logged as SKIPPED.
SMS_TEMPLATE_PAYMENT_RECEIPT_SUBMITTED=
SMS_TEMPLATE_PAYMENT_CONFIRMED=
SMS_TEMPLATE_PAYMENT_REJECTED=
SMS_TEMPLATE_CONSULTATION_REQUESTED=
SMS_TEMPLATE_CONSULTATION_CONFIRMED=
SMS_TEMPLATE_CONSULTATION_CANCELLED=
# Per-number limits on login codes (seconds between codes, codes per hour).
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=6
