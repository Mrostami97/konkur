DATABASE_URL="postgresql://konkur:konkur@localhost:5432/konkurcom?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Verified proxy peer CIDRs only; local/direct nginx defaults to an empty list.
TRUSTED_PROXY_CIDRS=
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=konkur
S3_SECRET_KEY=konkur123
S3_BUCKET=konkurcom-media

# Optional one-time administrator bootstrap. Leave both unset to disable it.
# Never commit real production values.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# SpotPlayer (offline DRM video). Copy the key from the SpotPlayer panel
# dashboard. Leave unset to run without video: courses then report that the
# integration is not configured instead of issuing licences that open nothing.
SPOTPLAYER_API_KEY=
# sms.ir sign-in codes: API key, the approved verify template id, and the
# template variable that holds the code (as written in the template, e.g. #CODE#).
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAMETER=CODE
