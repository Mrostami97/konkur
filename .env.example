# Copy to .env and supply strong, unique secrets before starting the stack.
# Use at least 16 characters. For POSTGRES_PASSWORD use URL-safe random characters
# because compose embeds it into DATABASE_URL. Existing database credentials
# must be changed in Postgres before changing this value; this is not rotation.

POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

WEB_DOMAIN=localhost
API_DOMAIN=api.localhost
TLS_MODE=auto
ACME_EMAIL=
ACME_STAGING=0

SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Verified CDN/proxy peer CIDRs, comma- or space-separated; empty for direct nginx.
# Review the current official list before setting this on the server:
# https://parspack.com/cdnips.txt — do not trust a range merely from a request header.
TRUSTED_PROXY_CIDRS=

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional administrator bootstrap. Leave both blank to disable.
# Use a strong unique password and do not commit real values.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional integrations. Keys stay only in the server .env, never in git.
SPOTPLAYER_API_KEY=
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAMETER=CODE
