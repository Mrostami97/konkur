# Local-safe defaults and production placeholders.
# Copy to .env and replace every production secret before exposing the stack.

POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me

WEB_DOMAIN=localhost
API_DOMAIN=api.localhost
TLS_MODE=auto
ACME_EMAIL=
ACME_STAGING=0

SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional administrator bootstrap. Leave both blank to disable.
# Use a strong unique password and do not commit real values.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
