# Next marks prerendered pages cacheable for a year (s-maxage=31536000). The
# CDN in front honours that, so after a deploy it would keep serving the old
# HTML -- whose JavaScript chunks no longer exist, leaving pages that load but
# do not respond. A minute at the edge keeps pages fast and deploys visible.
map $upstream_http_cache_control $web_cache_control {
    "~s-maxage=31536000" "public, max-age=0, s-maxage=60";
    default $upstream_http_cache_control;
}

# The API sends JSON uncompressed; Next compresses its own responses, and
# nginx never compresses a response twice.
gzip on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types application/json text/plain text/css application/javascript image/svg+xml application/manifest+json;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${WEB_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${WEB_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name www.${WEB_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${WEB_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${API_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${WEB_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Docker's embedded DNS (127.0.0.11) re-resolves the upstream on every
    # request (via the $upstream variable) instead of once at nginx startup,
    # so a redeploy that recreates the `web` container (new IP) doesn't
    # require restarting nginx too.
    resolver 127.0.0.11 valid=10s;

    # Browser traffic uses a same-origin API prefix. Strip `/api/` before
    # proxying because the Nest application exposes routes such as `/auth`
    # and `/healthz` at its root. Using a variable keeps Docker DNS dynamic
    # across API container recreation, just like the web upstream below.
    location = /api {
        return 308 /api/;
    }

    location ^~ /api/ {
        # Admins upload import zips and PDF notes; nginx refuses bodies over
        # 1 MB unless told otherwise.
        client_max_body_size 120m;
        set $api_upstream http://api:3001;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;
    }

    # Files from public/ come back with max-age=0, so every page view re-asked
    # for the font and the logo: one more round trip each on a slow link.
    location ^~ /fonts/ {
        set $upstream http://web:3000;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=604800" always;
    }

    location ~ ^/(brand|evidence|pdfjs)/|^/(icon-[0-9]+.png|manifest.json)$ {
        set $upstream http://web:3000;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
    }

    location / {
        set $upstream http://web:3000;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control $web_cache_control always;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.${WEB_DOMAIN};
    http2 on;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    return 308 https://${WEB_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${API_DOMAIN};
    http2 on;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    resolver 127.0.0.11 valid=10s;

    location / {
        client_max_body_size 120m;
        set $upstream http://api:3001;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
