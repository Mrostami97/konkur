{
  "name": "konkurcom-360",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.5.0",
      "body-parser@1": "1.20.9",
      "qs@6": "6.16.1",
      "postcss@8": "8.5.28",
      "uuid@11": "11.1.1",
      "fast-uri@3": "3.1.9",
      "ajv@8": "8.20.0",
      "glob@10": "10.5.0",
      "webpack@5": "5.104.1",
      "picomatch@4": "4.0.4",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "external-editor>tmp": "0.2.7",
      "proxy-addr@2": "2.0.8",
      "source-map-js@1": "1.2.2",
      "@istanbuljs/load-nyc-config>js-yaml": "4.3.2",
      "handlebars@4": "4.7.10"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "migrate:deploy": "pnpm --filter api prisma migrate deploy",
    "migrate:dev": "pnpm --filter api prisma migrate dev",
    "migrate:down": "pnpm --filter api run migrate:down",
    "migrate:reset": "pnpm --filter api prisma migrate reset --force",
    "seed": "pnpm --filter api run seed",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev"
  }
}
